<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/v0/processes/ns/" xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/v0/processes/ns/"
                  id="Definitions_Process_J41VhlFetch" targetNamespace="https://litlfred.github.io/smart-trust-demo/processes" exporter="smart-trust-demo" exporterVersion="1">
  <bpmn:resource id="caregiver" name="Caregiver"/>
  <bpmn:resource id="family-phone" name="Family phone"/>
  <bpmn:resource id="poc-provider" name="Point-of-care provider"/>
  <bpmn:resource id="national-portal" name="National health portal"/>
  <bpmn:resource id="poc-receiver" name="Point-of-care receiver"/>
  <bpmn:collaboration id="Collaboration_Process_J41VhlFetch">
    <bpmn:participant id="Participant_Process_J41VhlFetch" name="J4.1 Read a family member&#x27;s records at the point of care abroad" processRef="Process_J41VhlFetch"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_J41VhlFetch" name="J4.1 Read a family member&#x27;s records at the point of care abroad" isExecutable="false">
    <bpmn:documentation>J4.1. Abroad, a child of the family needs care. The caregiver, the VHL Holder (IHE ITI VHL; Holder in SMART Trust and smart-trust-phw, requirement provide-a-vhl-to-a-receiver), opens her QR on the family phone and tells the passcode. The hospital system, a VHL Receiver (Receiver in SMART Trust and smart-trust-phw), verifies the HCERT against the GDHCN trust list, requests the manifest by ITI-YY5 with an HTTP Message Signature (STT-VHL-005, STT-VHL-006, STT-VHL-008) and decrypts the documents (STT-VHL-007). Country B&#x27;s portal checks the passcode, returns the manifest and logs every request, granted or refused, as an AuditEvent at home (IHE BALP). If the HCERT does not verify, there is no digital verification: the VHL is not followed and the records are treated like paper. As in J3, loading the DID documents is a PRECONDITION of this visit, not a step in it: the hospital verifies against its cached copy of the trust list and needs no connection to do so. It refreshes that cache nightly or hourly, where an offline site such as the J3 clinic refreshes about weekly.</bpmn:documentation>
    <bpmn:extensionElements>
      <bootstrap.processes:precondition id="did-documents-loaded" kind="stated"
        text="Before the family arrives, the hospital system's trust store already holds the GDHCN trust list's DID documents, including Country B's DSC DID document, loaded with HcertTrustStore.addDidDocument (STT-TRU-001, STT-TRU-002, STT-TRU-005). Trust-list presence is the DSC validity check (STT-VER-006). Loading DIDs is not a step of this visit."/>
      <bootstrap.processes:precondition id="did-list-from-last-refresh" kind="stated"
        text="The hospital's DID list is a cache it refreshes on a short schedule, nightly or hourly, from the list its own country retrieves as a Trust Network Participant from the GDHCN trust anchor (smart-trust-phw retrieve-pki-material). The hospital does not need to be online to verify: verification reads the cache and never fetches the list."/>
      <cat-harness.processes:policy enforcement="advisory"/><cat-harness.processes:log capture="off"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Process_J41VhlFetch">
      <bpmn:lane id="Lane_caregiver" name="Caregiver" partitionElementRef="caregiver">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_family-phone" name="Family phone" partitionElementRef="family-phone">
        <bpmn:flowNodeRef>Task_Open</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_poc-provider" name="Point-of-care provider" partitionElementRef="poc-provider">
        <bpmn:flowNodeRef>Task_Scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Unverified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_poc-receiver" name="Point-of-care receiver" partitionElementRef="poc-receiver">
        <bpmn:flowNodeRef>Task_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Decrypt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_national-portal" name="National health portal" partitionElementRef="national-portal">
        <bpmn:flowNodeRef>Task_Release</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="A child of the family needs care abroad"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_Open" name="Show the child&#x27;s VHL QR"><bpmn:extensionElements><bootstrap.processes:skill ref="wallet-hold-vhl"/></bpmn:extensionElements><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_Scan" name="Scan the QR and enter the passcode the caregiver says"><bpmn:extensionElements><bootstrap.processes:skill ref="receiver-scan-credential"/></bpmn:extensionElements><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_Verify" name="Verify the HCERT and read the VHL at key 5"><bpmn:documentation>STT-VER-001 against Country B's DSC on the trust list the preconditions establish; VHL expiry (STT-VHL-009). A DSC Country B published after the hospital's last refresh is not in its copy, so the HCERT fails at the trust-list step (STT-VER-006), naming that reason.</bpmn:documentation><bpmn:extensionElements><bootstrap.processes:skill ref="hcert-verify"/></bpmn:extensionElements><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Verified" name="HCERT verified?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Unverified" name="Not verified: treat records as paper"><bpmn:documentation>No digital verification: treat the records like paper. The HCERT failed verification. The typed result names the step and the reason (STT-VER-008), for example a DSC missing from the cached trust list (STT-VER-006). Nothing is digitally verified, so the VHL is not followed and no manifest is requested. Whatever the family can show, such as the paper DVCs or a QR read unverified (STT-VER-011), carries the same weight as a paper record: the clinician decides on it by clinical judgement and local policy, and records why it was not verified.</bpmn:documentation><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_Fetch" name="Request the manifest (ITI-YY5), signed"><bpmn:documentation>STT-VHL-005, STT-VHL-006, STT-VHL-008; the host does the HTTP, the library builds and reads (STT-VHL-010).</bpmn:documentation><bpmn:extensionElements><bootstrap.processes:skill ref="vhl-receive"/></bpmn:extensionElements><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Release" name="Check passcode, log access, return manifest"><bpmn:documentation>Check the passcode, return the manifest and log the access. The home country&#x27;s portal hosts the manifest (ITI-YY5). It checks the passcode and the link&#x27;s expiry and the consent the holder gave when sharing (IHE PCF), returns the manifest of encrypted files on success, and records every request, granted or refused, as an AuditEvent (IHE BALP) in the home country. A wrong passcode is refused and still logged. The records stay hosted at home: the receiver views them and nothing is copied into a registry abroad.</bpmn:documentation><bpmn:extensionElements><bootstrap.processes:skill ref="portal-serve-manifest"/></bpmn:extensionElements><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Decrypt" name="Decrypt the IPS and DVCs"><bpmn:documentation>JWE dir/A256GCM (STT-VHL-007).</bpmn:documentation><bpmn:extensionElements><bootstrap.processes:skill ref="vhl-receive"/></bpmn:extensionElements><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_Review" name="Review history, allergies and vaccinations"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="End" name="The child is treated with the full record"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Open"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Open" targetRef="Task_Scan"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Scan" targetRef="Task_Verify"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Verify" targetRef="Gateway_Verified"/>
    <bpmn:sequenceFlow id="Flow_8" name="yes" sourceRef="Gateway_Verified" targetRef="Task_Fetch"/>
    <bpmn:sequenceFlow id="Flow_9" name="no" sourceRef="Gateway_Verified" targetRef="Task_Unverified"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Unverified" targetRef="Task_Review"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Fetch" targetRef="Task_Release"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Release" targetRef="Task_Decrypt"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Decrypt" targetRef="Task_Review"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Review" targetRef="End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Process_J41VhlFetch">
      <bpmndi:BPMNShape id="Participant_Process_J41VhlFetch_di" bpmnElement="Participant_Process_J41VhlFetch" isHorizontal="true"><dc:Bounds x="100" y="60" width="1920" height="850" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_caregiver_di" bpmnElement="Lane_caregiver" isHorizontal="true"><dc:Bounds x="130" y="60" width="1890" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_family-phone_di" bpmnElement="Lane_family-phone" isHorizontal="true"><dc:Bounds x="130" y="230" width="1890" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_poc-provider_di" bpmnElement="Lane_poc-provider" isHorizontal="true"><dc:Bounds x="130" y="400" width="1890" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_poc-receiver_di" bpmnElement="Lane_poc-receiver" isHorizontal="true"><dc:Bounds x="130" y="570" width="1890" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_national-portal_di" bpmnElement="Lane_national-portal" isHorizontal="true"><dc:Bounds x="130" y="740" width="1890" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="277" y="127" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="235" y="169" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Open_di" bpmnElement="Task_Open"><dc:Bounds x="410" y="255" width="120" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Scan_di" bpmnElement="Task_Scan"><dc:Bounds x="585" y="425" width="120" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Verify_di" bpmnElement="Task_Verify"><dc:Bounds x="760" y="595" width="120" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Fetch_di" bpmnElement="Task_Fetch"><dc:Bounds x="1110" y="595" width="120" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Decrypt_di" bpmnElement="Task_Decrypt"><dc:Bounds x="1460" y="595" width="120" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Release_di" bpmnElement="Task_Release"><dc:Bounds x="1285" y="765" width="120" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review"><dc:Bounds x="1635" y="425" width="120" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1852" y="127" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1810" y="169" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="313" y="145" />
        <di:waypoint x="361.5" y="145" />
        <di:waypoint x="361.5" y="315" />
        <di:waypoint x="410" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="530" y="315" />
        <di:waypoint x="557.5" y="315" />
