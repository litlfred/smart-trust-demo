<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/0.1.0/processes/ns#" xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/0.1.0/processes/ns#"
                  id="Definitions_Process_J2ChwDiscovery" targetNamespace="https://litlfred.github.io/smart-trust-demo/processes" exporter="smart-trust-demo" exporterVersion="1">
  <bpmn:resource id="caregiver" name="Caregiver"/>
  <bpmn:resource id="community-health-worker" name="Community health worker"/>
  <bpmn:resource id="chw-app" name="CHW app"/>
  <bpmn:collaboration id="Collaboration_Process_J2ChwDiscovery">
    <bpmn:participant id="Participant_Process_J2ChwDiscovery" name="J2 Discover and refer an unregistered infant in Country B" processRef="Process_J2ChwDiscovery"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_J2ChwDiscovery" name="J2 Discover and refer an unregistered infant in Country B" isExecutable="false">
    <bpmn:documentation>J2, Return home, CHW discovery and referral. Back in Country B (home, XXH), where the family resides, the community health worker finds an infant born abroad who is missing from the household roster on a home visit. Offline, the CHW app adds the infant to the household (a FHIR Group, through a structured data capture form), reads the foreign DVCs without verifying them (read-unverified, STT-VER-011: the triage read stops before the trust lookup and marks every field unverified), saves the doses as reported by the family, not verified (Immunization.primarySource false), and refers the infant to the clinic for verification. Everything is queued on the phone and syncs when it next has a signal. The CHW app is a Receiver (SMART Trust, smart-trust-phw) that deliberately stops before trust; the caregiver provides the VDHC as Holder (smart-trust-phw requirement provide-a-vhl-to-a-receiver).</bpmn:documentation>
    <bpmn:extensionElements><cat-harness.processes:policy enforcement="advisory"/><cat-harness.processes:log capture="off"/></bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Process_J2ChwDiscovery">
      <bpmn:lane id="Lane_caregiver" name="Caregiver" partitionElementRef="caregiver">
        <bpmn:flowNodeRef>Task_Show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_community-health-worker" name="Community health worker" partitionElementRef="community-health-worker">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Slip</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_chw-app" name="CHW app" partitionElementRef="chw-app">
        <bpmn:flowNodeRef>Task_Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Refer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Home visit finds an unregistered infant"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_Show" name="Show the paper DVCs from Country A"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_Scan" name="Scan each QR with the CHW app"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_Read" name="Read each DVC unverified (triage)"><bpmn:documentation>read-unverified (STT-VER-011): strip HC1:, Base45, inflate within limits (STT-B45-002, STT-ZIP-002), bounded CBOR (STT-CBR-003), payloads read but flagged unverified; no trust list needed, fully offline.</bpmn:documentation><bpmn:extensionElements><bootstrap.processes:skill ref="hcert-verify"/></bpmn:extensionElements><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Register" name="Add the infant to the household; save the doses as reported, not verified"><bpmn:extensionElements><bootstrap.processes:skill ref="chw-register-infant"/></bpmn:extensionElements><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Refer" name="Create a referral to the home clinic for verification"><bpmn:extensionElements><bootstrap.processes:skill ref="chw-refer"/></bpmn:extensionElements><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_Slip" name="Explain the referral to the family"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="End" name="Family has a referral; the record syncs when online"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Show"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Show" targetRef="Task_Scan"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Scan" targetRef="Task_Read"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Read" targetRef="Task_Register"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Register" targetRef="Task_Refer"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Refer" targetRef="Task_Slip"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Slip" targetRef="End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Process_J2ChwDiscovery">
      <bpmndi:BPMNShape id="Participant_Process_J2ChwDiscovery_di" bpmnElement="Participant_Process_J2ChwDiscovery" isHorizontal="true"><dc:Bounds x="100" y="60" width="1570" height="510"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_caregiver_di" bpmnElement="Lane_caregiver" isHorizontal="true"><dc:Bounds x="130" y="60" width="1540" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_community-health-worker_di" bpmnElement="Lane_community-health-worker" isHorizontal="true"><dc:Bounds x="130" y="230" width="1540" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_chw-app_di" bpmnElement="Lane_chw-app" isHorizontal="true"><dc:Bounds x="130" y="400" width="1540" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="277" y="297" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="235" y="339" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Show_di" bpmnElement="Task_Show"><dc:Bounds x="405" y="105" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Scan_di" bpmnElement="Task_Scan"><dc:Bounds x="580" y="275" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Read_di" bpmnElement="Task_Read"><dc:Bounds x="755" y="445" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Register_di" bpmnElement="Task_Register"><dc:Bounds x="930" y="445" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Refer_di" bpmnElement="Task_Refer"><dc:Bounds x="1105" y="445" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Slip_di" bpmnElement="Task_Slip"><dc:Bounds x="1280" y="275" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1502" y="127" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1460" y="169" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="313" y="315"/><di:waypoint x="359" y="315"/><di:waypoint x="359" y="145"/><di:waypoint x="405" y="145"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="535" y="145"/><di:waypoint x="557" y="145"/><di:waypoint x="557" y="315"/><di:waypoint x="580" y="315"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="710" y="315"/><di:waypoint x="732" y="315"/><di:waypoint x="732" y="485"/><di:waypoint x="755" y="485"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="885" y="485"/><di:waypoint x="930" y="485"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="1060" y="485"/><di:waypoint x="1105" y="485"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1235" y="485"/><di:waypoint x="1257" y="485"/><di:waypoint x="1257" y="315"/><di:waypoint x="1280" y="315"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1410" y="315"/><di:waypoint x="1456" y="315"/><di:waypoint x="1456" y="145"/><di:waypoint x="1502" y="145"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
