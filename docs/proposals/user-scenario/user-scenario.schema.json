{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litlfred.github.io/smart-trust-demo/docs/proposals/user-scenario/user-scenario.schema.json",
  "_draft": "PROPOSAL for a cat-harness kind (bean smart-trust-demo-kg01). Hand-written here; once adopted, the source is a Zod schema in cat-harness-tools and this file is generated.",
  "title": "User scenario",
  "description": "A DAK user scenario (smart-base logical model UserScenario: id, title, description, personas) told as a journey map: its ordered steps, and for each step who does what and how they feel, what goes wrong and what makes it work, and how far the record can be trusted. Each step links to the user stories it satisfies (DAK functional requirements: actor, I want, so that), the BPMN tasks that carry it out, the requirements it exercises and the FHIR examples it produces. One file per scenario.",
  "$ref": "#/$defs/user-scenario~10.1.0",
  "$defs": {
    "user-scenario/0.1.0": {
      "type": "object",
      "properties": {
        "$schema": {
          "const": "user-scenario/0.1.0"
        },
        "id": {
          "$ref": "#/$defs/id",
          "description": "DAK UserScenario.id."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "DAK UserScenario.title."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "DAK UserScenario.description[x]: Markdown, or a repository-relative path to a .md file."
        },
        "personas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "DAK UserScenario.personas: the ids of the actors (scenarios/actors/*.json) who take part. Every actor a step names is listed here."
        },
        "follows": {
          "$ref": "#/$defs/id",
          "description": "The scenario this one continues, when one story is told as several scenarios (J2 follows J1). The first has none."
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "description": "When the scenario happens, in the story's own terms (\"birth day\", \"+3 weeks\")."
        },
        "where": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "trustLadder": {
          "type": "string",
          "minLength": 1,
          "description": "The id of the code-list whose ordered codes are the record's trust states (step.record.state)."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "The scenario in order. Step ids are unique within the scenario."
        }
      },
      "required": [
        "$schema",
        "id",
        "title",
        "description",
        "personas",
        "steps"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$",
          "description": "The step's code in the story (J1, J2a, J4.0b)."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "description": "One sentence that tells the step."
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "where": {
          "type": "string",
          "minLength": 1
        },
        "touchpoint": {
          "type": "string",
          "minLength": 1,
          "description": "What the people touch: a paper card, an app, a QR."
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "Markdown."
              },
              "requirements": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "title",
              "description"
            ],
            "additionalProperties": false
          },
          "description": "What must already hold before the step, and is not a part of it (a DSC shared with the trust anchor, a trust list loaded)."
        },
        "narrative": {
          "type": "string",
          "minLength": 1,
          "description": "The step told in full, Markdown, naming the requirements and examples in the order they happen. docs/journeys.md \"User scenarios\" is generated from it."
        },
        "lead": {
          "$ref": "#/$defs/id",
          "description": "The actor the step is told through."
        },
        "experiences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/experience"
          },
          "description": "One per actor present, the lead among them."
        },
        "painPoint": {
          "type": "string",
          "minLength": 1,
          "description": "What goes wrong without the enabler."
        },
        "enabler": {
          "type": "string",
          "minLength": 1,
          "description": "What makes the step work."
        },
        "record": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "minLength": 1,
              "description": "A code of the scenario's trustLadder."
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "heldWhere": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "description",
            "heldWhere"
          ],
          "additionalProperties": false,
          "description": "How far the record can be trusted once the step is done, and where it is."
        },
        "handoff": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "from": {
              "$ref": "#/$defs/id"
            },
            "to": {
              "$ref": "#/$defs/id"
            },
            "offline": {
              "type": "boolean"
            }
          },
          "required": [
            "summary"
          ],
          "additionalProperties": false,
          "description": "What passes on to the next step."
        },
        "whatIf": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "scenario",
              "outcome"
            ],
            "additionalProperties": false
          },
          "description": "Alternative paths: what happens if something differs. A path the BPMN draws is linked through realisedBy instead."
        },
        "stories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "The user stories (scenarios/stories.json, DAK FunctionalRequirement) this step satisfies, in whole or in part. A story may be satisfied across several steps."
        },
        "realisedBy": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "process": {
                "type": "string",
                "minLength": 1,
                "description": "Path of the BPMN file, relative to the repository root."
              },
              "tasks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Ids of the flow nodes in that process. Omitted: the whole process."
              }
            },
            "required": [
              "process"
            ],
            "additionalProperties": false
          },
          "description": "The BPMN that carries the step out. One step may span processes; one process may span steps."
        },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Ids of the requirements the step exercises (smart-trust-tools req: nodes, e.g. STT-PAY-001)."
        },
        "examples": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z]+/[A-Za-z0-9.-]+$"
          },
          "description": "The FHIR examples the step produces, as Type/id."
        }
      },
      "required": [
        "id",
        "title",
        "lead",
        "experiences"
      ],
      "additionalProperties": false
    },
    "experience": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/id"
        },
        "doing": {
          "type": "string",
          "minLength": 1
        },
        "feeling": {
          "type": "string",
          "minLength": 1,
          "description": "In their own words."
        },
        "emotion": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2,
          "description": "-2 distressed, -1 worried, 0 neutral, 1 reassured, 2 delighted."
        }
      },
      "required": [
        "actor",
        "doing"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
