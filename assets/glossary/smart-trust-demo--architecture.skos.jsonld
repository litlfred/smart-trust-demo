    {
      "@id": "https://litlfred.github.io/smart-trust-demo/v0/ns/glossary/architecture/actor-onesa-national-portal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-trust-demo/v0/ns/glossary/architecture"
      },
      "skos:prefLabel": [
        {
          "@value": "Onesa national health portal and gateway (Country B, XXK)"
        }
      ],
      "skos:altLabel": [
        "Onesan national health portal"
      ],
      "skos:definition": [
        {
          "@value": "Onesa's national FHIR server behind the OHS FHIR Info Gateway (J4.0, J4.1): assembles each family member's IPS and DVCs, issues each as a passcode-protected Verifiable Health Link in an HCERT signed with Country B's DSC, hosts the manifests (ITI-YY5), checks passcode, expiry and consent on each request, and logs every access as an AuditEvent at home. Country B is played on the GDHCN DEV network by the test participant XXK, so no real ministry's key is implied."
        }
      ],
      "dcterms:source": "scenarios/actors/onesa-national-portal.json",
      "skos:note": "candidate"
    },
    {
