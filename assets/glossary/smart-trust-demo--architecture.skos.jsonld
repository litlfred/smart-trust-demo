      "skos:altLabel": [
        "Lomaru District Health Center EHR"
      ],
      "skos:definition": [
        {
          "@value": "The district health center's OHS-based record system in Onesa (Country B), on a tablet (J3): verifies DVCs against its cached GDHCN trust list, imports them with provenance, adds the Onesan schedule code beside each foreign vaccine code and evaluates the national schedule. A Receiver; Country B, as a Trust Network Participant, retrieves the PKI material it uses. Its trust store is loaded before the visit, from the copy of the trust list it refreshed when last connected (for an offline clinic, about weekly); it fetches nothing during J3."
        }
      ],
      "dcterms:source": "scenarios/actors/district-health-center-ehr.json",
      "skos:note": "candidate"
    },
