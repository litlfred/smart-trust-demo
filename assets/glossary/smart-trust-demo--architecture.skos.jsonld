      ],
      "skos:definition": [
        {
          "@value": "The VHL viewer of a primary care clinic in Kesaro, Taifafeki, back in Country A a year after the birth (J4.1): verifies the VHL, fetches the manifest with an HTTP Message Signature after the passcode is entered, and decrypts the documents for viewing. Its trust store is loaded before the visit from a cache of the GDHCN trust list refreshed nightly or hourly; verifying needs no connection."
        }
      ],
      "dcterms:source": "scenarios/actors/kesaro-clinic-viewer.json",
      "skos:note": "candidate"
