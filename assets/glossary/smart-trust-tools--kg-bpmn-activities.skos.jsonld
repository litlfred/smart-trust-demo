      },
      "skos:prefLabel": [
        {
          "@value": "Strip HC1:, Base45-decode and inflate"
        }
      ],
      "skos:definition": [
        {
          "@value": "Strip HC1: (refusing any other context), Base45-decode strictly and inflate within a size limit."
        }
      ],
      "skos:notation": "Task_Decode",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-verification.bpmn#Task_Decode",
