      },
      "skos:prefLabel": [
        {
          "@value": "Prefix HC1:"
        }
      ],
      "skos:definition": [
        {
          "@value": "Prefix the context identifier HC1: to make the QR-ready string."
        }
      ],
      "skos:notation": "Task_Prefix",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-issuance.bpmn#Task_Prefix",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities/process_hcertissuance.task_prepare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prepare the Sig_structure"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build the COSE Sig_structure from the protected header (alg, kid = SHA-256 of the DSC, first 8 bytes) and the payload, and hand its bytes out to be signed."
        }
      ],
      "skos:notation": "Task_Prepare",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-issuance.bpmn#Task_Prepare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities/process_hcertissuance.task_render",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render the QR code (Alphanumeric, EC Q)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The application renders the HC1 string as a QR code in Alphanumeric mode, error correction Q, with its own QR encoder."
        }
      ],
      "skos:notation": "Task_Render",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-issuance.bpmn#Task_Render",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities/process_hcertissuance.task_selectpayload",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Select the payload type and subclaim"
        }
      ],
      "skos:definition": [
        {
          "@value": "Choose the logical model and the hcert subclaim for the use case from the registry QR Code Generation 2 defines: a DVC (key -6) when the certificate must verify offline, a VHL (key 5) when the records are larger than a QR code holds."
        }
      ],
      "skos:notation": "Task_SelectPayload",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-issuance.bpmn#Task_SelectPayload",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities/process_hcertissuance.task_sign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign the bytes with the DSC key"
        }
      ],
      "skos:definition": [
        {
          "@value": "The key holder signs the Sig_structure bytes with the DSC private key (ES256, or PS256) and returns the raw signature. The key never leaves it."
        }
      ],
      "skos:notation": "Task_Sign",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-issuance.bpmn#Task_Sign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities/process_hcertverification.task_check",
