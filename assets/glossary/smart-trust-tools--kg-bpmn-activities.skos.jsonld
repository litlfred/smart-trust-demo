      },
      "skos:prefLabel": [
        {
          "@value": "Attach the signature as COSE_Sign1"
        }
      ],
      "skos:definition": [
        {
          "@value": "Attach the returned signature to make the COSE_Sign1, checking it is the length the algorithm gives (64 bytes for ES256, r||s)."
        }
      ],
      "skos:notation": "Task_Finish",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-issuance.bpmn#Task_Finish",
      "skos:note": "candidate"
    },
