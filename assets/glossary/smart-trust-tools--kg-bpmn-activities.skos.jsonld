        "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check signature, key usage, CWT and time; dispatch the payload"
        }
      ],
      "skos:definition": [
        {
          "@value": "Verify the signature with each candidate, then the DSC's key usage for this payload type, the CWT's iat and exp against now, and dispatch the payload by subclaim. Every failure is a value naming its step and reason."
        }
      ],
      "skos:notation": "Task_Check",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-verification.bpmn#Task_Check",
      "skos:note": "candidate"
    },
