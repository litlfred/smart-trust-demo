        {
          "@value": "Parse COSE_Sign1 and validate the protected header"
        }
      ],
      "skos:definition": [
        {
          "@value": "Parse the COSE_Sign1 within depth and size limits and check the protected header: a known alg, and a kid of 8 bytes."
        }
      ],
      "skos:notation": "Task_Parse",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-verification.bpmn#Task_Parse",
