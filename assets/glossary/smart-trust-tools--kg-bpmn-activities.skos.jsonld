      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compress with ZLIB"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compress the COSE_Sign1 with ZLIB/DEFLATE, after signing, never before."
        }
      ],
      "skos:notation": "Task_Compress",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-issuance.bpmn#Task_Compress",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities/process_hcertissuance.task_encodecbor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Serialise as deterministic CBOR"
        }
      ],
      "skos:definition": [
        {
          "@value": "Serialise the claim set as RFC 8949 deterministic CBOR, so the same claims always give the same bytes."
        }
      ],
      "skos:notation": "Task_EncodeCbor",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-issuance.bpmn#Task_EncodeCbor",
      "skos:note": "candidate"
    },
    {
