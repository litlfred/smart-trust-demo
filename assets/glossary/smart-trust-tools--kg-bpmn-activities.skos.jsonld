      "skos:definition": [
        {
          "@value": "Build the payload and validate it against its logical model (DVCMin, or the VHL payload), keeping elements the library does not know."
        }
      ],
      "skos:notation": "Task_AssemblePayload",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-issuance.bpmn#Task_AssemblePayload",
