      ],
      "skos:definition": [
        {
          "@value": "Generate a 32-byte random key for the link and encrypt each document as JWE compact, dir / A256GCM."
        }
      ],
      "skos:notation": "Task_Key",
      "dcterms:source": "smart-trust-tools/processes/content/vhl-sharing.bpmn#Task_Key",
