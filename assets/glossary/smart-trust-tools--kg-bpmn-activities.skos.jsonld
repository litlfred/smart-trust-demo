    {
      "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities/process_hcertissuance.task_base45",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Encode as Base45"
        }
      ],
      "skos:definition": [
        {
          "@value": "Encode the compressed bytes as RFC 9285 Base45, the alphabet QR Alphanumeric mode stores compactly."
        }
      ],
      "skos:notation": "Task_Base45",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-issuance.bpmn#Task_Base45",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities/process_hcertissuance.task_buildcwt",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-trust-tools/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the CWT claim set"
        }
      ],
      "skos:definition": [
        {
          "@value": "Wrap the payload in a CWT claim set: iss, iat, exp inside the DSC's validity, and the payload at hcert (-260) under its subclaim."
        }
      ],
      "skos:notation": "Task_BuildCwt",
      "dcterms:source": "smart-trust-tools/processes/content/hcert-issuance.bpmn#Task_BuildCwt",
      "skos:note": "candidate"
    },
    {
