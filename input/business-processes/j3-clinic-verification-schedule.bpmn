<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/0.1.0/processes/ns#" xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/0.1.0/processes/ns#"
                  id="Definitions_Process_J3ClinicVerification" targetNamespace="https://litlfred.github.io/smart-trust-demo/processes" exporter="smart-trust-demo" exporterVersion="1">
  <bpmn:resource id="caregiver" name="Caregiver"/>
  <bpmn:resource id="home-clinic-provider" name="Home clinic provider"/>
  <bpmn:resource id="home-clinic-ehr" name="Home clinic EHR"/>
  <bpmn:collaboration id="Collaboration_Process_J3ClinicVerification">
    <bpmn:participant id="Participant_Process_J3ClinicVerification" name="J3 Verify, import and schedule at the home clinic" processRef="Process_J3ClinicVerification"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_J3ClinicVerification" name="J3 Verify, import and schedule at the home clinic" isExecutable="false">
    <bpmn:documentation>J3, Clinic verification and schedule generation, in Country B. The clinic EHR (Receiver in SMART Trust and smart-trust-phw, VHL Receiver side in IHE ITI VHL) holds a copy of the GDHCN trust list, which the trust anchor (Trust Network Anchor; IHE Trust Anchor) distributes and Country B, a Trust Network Participant, retrieves (smart-trust-phw retrieve-pki-material). Loading the DID documents is a PRECONDITION of this visit, not a step in it: the clinic may be offline throughout, so the list it verifies against is the one it last refreshed, about weekly, when the CHW visits the base clinic or district health office. It verifies each foreign DVC in the STT-VER-001 order against XXR's DSC DID document, imports the verified doses with provenance, adds the national schedule code beside each foreign vaccine code (ConceptMap; the nurse decides any product with no mapping) and evaluates the national schedule, which finds the 6-week doses due and books them.</bpmn:documentation>
    <bpmn:extensionElements>
      <bootstrap.processes:precondition id="did-documents-loaded" kind="stated"
        text="Before the family arrives, the clinic EHR's trust store already holds the GDHCN trust list's DID documents, including XXR's DSC DID document (did:web:tng-cdn-dev.who.int:v2:trustlist:-:XXR:DSC as the DEV host serves it; the guide prints the production host, smart-trust-tools OI-34), loaded with HcertTrustStore.addDidDocument (STT-TRU-001, STT-TRU-002, STT-TRU-005). Trust-list presence is the DSC validity check (STT-VER-006). Loading DIDs is not a step of this visit."/>
      <bootstrap.processes:precondition id="did-list-from-last-refresh" kind="stated"
        text="The clinic may be offline for the whole visit and fetches nothing during it. Its DID list is the copy refreshed at its last connection, about weekly: for a clinic with no connection of its own, the CHW's last visit to the base clinic or district health office, where Country B, a Trust Network Participant, retrieves the list the GDHCN trust anchor distributes (smart-trust-phw retrieve-pki-material)."/>
      <cat-harness.processes:policy enforcement="advisory"/><cat-harness.processes:log capture="off"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Process_J3ClinicVerification">
      <bpmn:lane id="Lane_caregiver" name="Caregiver" partitionElementRef="caregiver">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_home-clinic-provider" name="Home clinic provider" partitionElementRef="home-clinic-provider">
        <bpmn:flowNodeRef>Task_Scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Unverified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_home-clinic-ehr" name="Home clinic EHR" partitionElementRef="home-clinic-ehr">
        <bpmn:flowNodeRef>Task_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Import</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Map</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Schedule</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Family arrives with the referral and the paper DVCs"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_Scan" name="Scan the QRs and open the referral"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_Verify" name="Verify each HCERT against the trust list"><bpmn:documentation>HcertVerifier.verify: STT-VER-001 order, no payload before the signature (STT-VER-002), every DSC with the kid tried (STT-KID-002), EKU (STT-VER-004), time with an injected clock (STT-VER-005), typed result naming step and reason (STT-VER-008), fully offline (STT-VER-009); several payloads per HCERT (STT-SEL-004). It checks against the DID list the preconditions establish: a DSC added to the GDHCN list after the clinic&#x27;s last refresh is not in that copy, so its DVC fails at the trust-list step (STT-VER-006) and takes the &quot;no&quot; path, with that reason, until the next refresh.</bpmn:documentation><bpmn:extensionElements><bootstrap.processes:skill ref="hcert-verify"/></bpmn:extensionElements><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Verified" name="Every DVC verified?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Unverified" name="Record the failure reason; decide doses by national policy"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_Import" name="Import the doses as FHIR Immunization resources"><bpmn:extensionElements><bootstrap.processes:skill ref="ehr-import-immunization"/></bpmn:extensionElements><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Map" name="Add the national schedule code beside the foreign vaccine code"><bpmn:documentation>The imported doses keep the issuer&#x27;s vaccine coding (WHO PreQual product, as signed in the DVC) and gain the national schedule coding beside it, never in its place. The EHR translates with the national ConceptMap; a product with no mapping goes to the nurse, who confirms the equivalent schedule antigen and dose, and that decision is recorded so the next clinic need not repeat it.</bpmn:documentation><bpmn:extensionElements><bootstrap.processes:skill ref="map-vaccine-codes"/></bpmn:extensionElements><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Schedule" name="Evaluate the national schedule"><bpmn:documentation>PlanDefinition/$apply over the imported Immunizations, read by their national schedule codes: the Hep B and BCG birth doses count; the 6-week doses (pentavalent, bOPV, PCV) are due, and a reminder Task is created for that date.</bpmn:documentation><bpmn:extensionElements><bootstrap.processes:skill ref="schedule-evaluate"/></bpmn:extensionElements><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_Plan" name="Give due doses and book the next visit"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="End" name="The child is on Country B&#x27;s schedule"><bpmn:incoming>Flow_11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Scan"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Scan" targetRef="Task_Verify"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Verify" targetRef="Gateway_Verified"/>
    <bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gateway_Verified" targetRef="Task_Import"/>
    <bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gateway_Verified" targetRef="Task_Unverified"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Import" targetRef="Task_Map"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Map" targetRef="Task_Schedule"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Unverified" targetRef="Task_Plan"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Schedule" targetRef="Task_Plan"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Plan" targetRef="End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Process_J3ClinicVerification">
      <bpmndi:BPMNShape id="Participant_Process_J3ClinicVerification_di" bpmnElement="Participant_Process_J3ClinicVerification" isHorizontal="true"><dc:Bounds x="100" y="60" width="1745" height="510"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_caregiver_di" bpmnElement="Lane_caregiver" isHorizontal="true"><dc:Bounds x="130" y="60" width="1715" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_home-clinic-provider_di" bpmnElement="Lane_home-clinic-provider" isHorizontal="true"><dc:Bounds x="130" y="230" width="1715" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_home-clinic-ehr_di" bpmnElement="Lane_home-clinic-ehr" isHorizontal="true"><dc:Bounds x="130" y="400" width="1715" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="277" y="127" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="235" y="169" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Scan_di" bpmnElement="Task_Scan"><dc:Bounds x="405" y="275" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Verify_di" bpmnElement="Task_Verify"><dc:Bounds x="580" y="445" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Verified_di" bpmnElement="Gateway_Verified" isMarkerVisible="true"><dc:Bounds x="795" y="460" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="760" y="516" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Unverified_di" bpmnElement="Task_Unverified"><dc:Bounds x="930" y="275" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Import_di" bpmnElement="Task_Import"><dc:Bounds x="930" y="445" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Schedule_di" bpmnElement="Task_Schedule"><dc:Bounds x="1280" y="445" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Map_di" bpmnElement="Task_Map"><dc:Bounds x="1105" y="445" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Plan_di" bpmnElement="Task_Plan"><dc:Bounds x="1455" y="275" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1677" y="127" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1635" y="169" width="120" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="313" y="145"/><di:waypoint x="359" y="145"/><di:waypoint x="359" y="315"/><di:waypoint x="405" y="315"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="535" y="315"/><di:waypoint x="557" y="315"/><di:waypoint x="557" y="485"/><di:waypoint x="580" y="485"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="710" y="485"/><di:waypoint x="795" y="485"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="845" y="485"/><di:waypoint x="930" y="485"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="820" y="460"/><di:waypoint x="820" y="315"/><di:waypoint x="930" y="315"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1060" y="485"/><di:waypoint x="1105" y="485"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1060" y="315"/><di:waypoint x="1455" y="315"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1410" y="485"/><di:waypoint x="1432" y="485"/><di:waypoint x="1432" y="315"/><di:waypoint x="1455" y="315"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1585" y="315"/><di:waypoint x="1631" y="315"/><di:waypoint x="1631" y="145"/><di:waypoint x="1677" y="145"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1235" y="485"/><di:waypoint x="1280" y="485"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
