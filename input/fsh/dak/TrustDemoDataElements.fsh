CodeSystem: TrustDemoVerificationFailureReason
Id: TrustDemoVerificationFailureReason
Title: "Verification failure reasons"
Description: "The closed set of reasons a DVC fails verification, shared by the Kotlin and Rust HCERT libraries (STT-VER-008)."
* ^experimental = true
* ^caseSensitive = true
* #BadPrefix "Bad prefix" "The text does not start with the HC1: prefix."
* #UnsupportedContextVersion "Unsupported context version" "The context identifier names a version the verifier does not support."
* #Base45Invalid "Base45 invalid" "The text is not valid Base45."
* #InflateFailed "Inflate failed" "The compressed bytes do not decompress."
* #LimitExceeded "Limit exceeded" "A decode limit (size or depth) was exceeded."
* #CoseMalformed "COSE malformed" "The bytes are not a well-formed COSE_Sign1."
* #HeaderInvalid "Header invalid" "A COSE header is missing or not as required."
* #UnsupportedAlgorithm "Unsupported algorithm" "The signature algorithm is not one the verifier accepts."
* #KidNotFound "Key not found" "No certificate on the verifier's copy of the trust list has the kid (STT-VER-006)."
* #SignatureInvalid "Signature invalid" "The signature does not verify with any certificate with the kid."
* #KeyUsageMismatch "Key usage mismatch" "The signer's certificate may not sign this kind of certificate."
* #Expired "Expired" "The certificate's expiry has passed."
* #NotYetValid "Not yet valid" "The certificate's issued-at time is in the future."
* #HcertMissing "HCERT missing" "The claim set has no hcert claim."
* #MultipleSubclaims "Multiple subclaims" "The hcert claim has more subclaims than the verifier accepts."
* #PayloadInvalid "Payload invalid" "The payload does not conform to its logical model."

ValueSet: TrustDemoVerificationFailureReasonVS
Id: TrustDemoVerificationFailureReasonVS
Title: "Verification failure reasons"
Description: "Every code of TrustDemoVerificationFailureReason."
* ^experimental = true
* include codes from system TrustDemoVerificationFailureReason

CodeSystem: TrustDemoDvcOutcome
