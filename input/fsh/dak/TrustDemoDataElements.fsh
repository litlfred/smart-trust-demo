Id: TrustDemoVerificationResultVS
Title: "Result of reading a DVC"
Description: "Every code of TrustDemoVerificationResult."
* ^experimental = true
* include codes from system TrustDemoVerificationResult

CodeSystem: TrustDemoVerificationStep
Id: TrustDemoVerificationStep
Title: "Verification steps"
Description: "The steps of DVC verification in the order they run (STT-VER-001), as the HCERT library names them in its typed result (STT-VER-008)."
* ^experimental = true
* ^caseSensitive = true
* #prefix "Prefix" "The HC1: context prefix and version."
* #base45 "Base45" "Base45 decoding of the QR text."
* #inflate "Inflate" "ZLIB decompression, within limits."
* #cose "COSE" "Parsing the COSE_Sign1 structure."
* #header "Header" "The protected and unprotected headers."
* #trust-lookup "Trust lookup" "Finding the signer's certificate by kid on the trust list."
* #signature "Signature" "Checking the signature with the signer's key."
* #key-usage "Key usage" "Checking the signer's certificate may sign this kind of certificate."
* #cwt "CWT" "Reading the CWT claim set."
* #time "Time" "Checking issued-at and expiry against the verifier's clock."
* #hcert "HCERT" "Finding the hcert claim and its subclaim."
* #payload "Payload" "Reading the payload against its logical model."

ValueSet: TrustDemoVerificationStepVS
Id: TrustDemoVerificationStepVS
