    {
      "@id": "ImplementationGuide-smart.who.int.trust-demo.jsonld",
      "@type": "fhir:ImplementationGuide",
      "dcterms:identifier": "ImplementationGuide/smart.who.int.trust-demo",
      "dcterms:title": "SMART Trust demonstrator: journeys J1 to J4",
      "dcterms:description": "The user journeys of one cross-border family, as the VaxLink walkthrough tells them (birth-dose DVCs in Thailand, CHW registration and triage read in Lao PDR, clinic verification, vaccine-code mapping and schedule, family VHLs on one phone, viewed and audited back in Thailand) as a WHO SMART Guidelines L2 DAK and L3 implementation guide, built on the SMART Trust HCERT libraries.",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-demo/ImplementationGuide/smart.who.int.trust-demo"
      }
    }
  ]
}
