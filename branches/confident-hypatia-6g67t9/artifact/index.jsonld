    {
      "@id": "CodeSystem-TrustDemoVerificationFailureReason.jsonld",
      "@type": "fhir:CodeSystem",
      "dcterms:identifier": "CodeSystem/TrustDemoVerificationFailureReason",
      "dcterms:title": "Verification failure reasons",
      "dcterms:description": "The closed set of reasons a DVC fails verification, shared by the Kotlin and Rust HCERT libraries (STT-VER-008).",
      "dcterms:type": "Terminology: Code Systems",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-demo/CodeSystem/TrustDemoVerificationFailureReason"
      }
    },
    {
      "@id": "CodeSystem-TrustDemoVerificationResult.jsonld",
      "@type": "fhir:CodeSystem",
      "dcterms:identifier": "CodeSystem/TrustDemoVerificationResult",
      "dcterms:title": "Result of reading a DVC",
      "dcterms:description": "What the HCERT library returns for one scanned DVC: a verified result, a failed result naming the step and reason (STT-VER-008), or the distinct result of the unverified triage read (STT-VER-011).",
      "dcterms:type": "Terminology: Code Systems",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-demo/CodeSystem/TrustDemoVerificationResult"
      }
    },
    {
      "@id": "CodeSystem-TrustDemoVerificationStep.jsonld",
      "@type": "fhir:CodeSystem",
