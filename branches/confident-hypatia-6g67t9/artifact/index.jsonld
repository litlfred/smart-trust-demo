    {
      "@id": "Organization-TrustDemoLaoPortalOrg.jsonld",
      "@type": "fhir:Organization",
      "dcterms:identifier": "Organization/TrustDemoLaoPortalOrg",
      "dcterms:title": "TrustDemoLaoPortalOrg",
      "dcterms:description": "Lao PDR national health portal (demonstrator, GDHCN DEV participant XXH)",
