      "dcterms:identifier": "ValueSet/TrustDemoVhlRefusalReasonVS",
      "dcterms:title": "Why a shared link released nothing",
      "dcterms:description": "Every code of TrustDemoVhlRefusalReason.",
      "dcterms:type": "Terminology: Value Sets",
