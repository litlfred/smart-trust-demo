  "schema:identifier": "id-771ad083bc135b4b9362796ee7f3cbf2",
  "schema:name": "Onesa national health portal and gateway (Country B, XXK)",
  "schema:description": "Onesa national health portal and gateway (Country B, XXK): Onesa's national FHIR server behind the OHS FHIR Info Gateway (J4.0, J4.1): assembles each family member's IPS and DVCs, issues each as a passcode-protected Verifiable Health Link in an HCERT signed with Country B's DSC, hosts the manifests (ITI-YY5), checks passcode, expiry and consent on each request, and logs every access as an AuditEvent at home. Country B is played on the GDHCN DEV network by the test participant XXK, so no real ministry's key is implied.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-trust-demo/archimate/0.1.0"
}
