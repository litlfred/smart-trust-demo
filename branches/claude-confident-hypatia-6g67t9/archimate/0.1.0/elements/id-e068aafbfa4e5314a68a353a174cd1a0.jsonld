  "schema:identifier": "id-e068aafbfa4e5314a68a353a174cd1a0",
  "schema:name": "Vientiane District Health Center EHR",
  "schema:description": "Vientiane District Health Center EHR (Country B): The district health center's OHS-based record system in Lao PDR (Country B), on a tablet (J3): verifies DVCs against its cached GDHCN trust list, imports them with provenance, adds the Lao schedule code beside each foreign vaccine code and evaluates the national schedule. A Receiver; Country B, as a Trust Network Participant, retrieves the PKI material it uses. Its trust store is loaded before the visit, from the copy of the trust list it refreshed when last connected (for an offline clinic, about weekly); it fetches nothing during J3.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-trust-demo/archimate/0.1.0.jsonld"
}
