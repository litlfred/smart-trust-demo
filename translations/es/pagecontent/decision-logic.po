msgstr "<a0>STD-SEM-001</a0>"

#: input/pagecontent/decision-logic.md:51
msgid "<a0>STD-SEM-001</a0> (map): the published national map has an equivalent; both codings are kept, as in TrustDemoJ3Bcg."
msgstr "<a0>STD-SEM-001</a0> (correspondencia): la tabla nacional de correspondencias publicada tiene un equivalente; se conservan ambas codificaciones, como en TrustDemoJ3Bcg."

#: input/pagecontent/decision-logic.md:53
msgid "<a0>STD-SEM-001</a0> (unmapped): no equivalent is known, and none is guessed."
msgstr "<a0>STD-SEM-001</a0> (sin correspondencia): no se conoce ningún equivalente, y no se supone ninguno."

