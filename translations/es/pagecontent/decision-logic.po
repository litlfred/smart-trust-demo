msgstr "Sirve a: <a0>J3 Verificar, importar y programar en la clínica del país de residencia</a0>: Evaluar el calendario nacional ({code0})"

#: input/pagecontent/decision-logic.md:77
#, python-brace-format
msgid "Serves: <a0>J3 Verify, import and schedule at the home clinic</a0>: Evaluate the national schedule ({code0}); Give due doses and book the next visit ({code1})"
msgstr "Sirve a: <a0>J3 Verificar, importar y programar en la clínica del país de residencia</a0>: Evaluar el calendario nacional ({code0}); Administrar las dosis pendientes y programar la próxima visita ({code1})"

