# ── Pinned French forms ──
#. World Health Organization; official French name Organisation mondiale de la Santé.
msgid "WHO"
msgstr "OMS"

#. GDHCN trust network.
msgid "trust network"
msgstr "réseau de confiance"

#. IHE VHL profile; acronym VHL kept.
msgid "Verifiable Health Link"
msgstr "lien de santé vérifiable"

msgid "verifiable health link"
msgstr "lien de santé vérifiable"

#. The person holding a health document.
msgid "holder"
msgstr "titulaire"

#. Party issuing and signing a health document.
msgid "issuer"
msgstr "émetteur"

#. Party verifying a health document.
msgid "verifier"
msgstr "vérificateur"

msgid "trust anchor"
msgstr "ancre de confiance"

msgid "public key"
msgstr "clé publique"

msgid "health certificate"
msgstr "certificat de santé"

#. WHO's French name; acronym GDHCN kept.
msgid "Global Digital Health Certification Network"
msgstr "Réseau mondial de certification de la santé numérique"

#. IHR (2005) French text; acronym ICVP kept.
msgid "International Certificate of Vaccination or Prophylaxis"
msgstr "certificat international de vaccination ou de prophylaxie"

#. Acronym DSC kept.
msgid "Document Signer Certificate"
msgstr "certificat de signataire de documents"

msgid "revocation"
msgstr "révocation"

#. Onboarding of a participant to the trust network.
msgid "onboarding"
msgstr "intégration"

#. WHO SMART Guidelines.
msgid "SMART Guidelines"
msgstr "lignes directrices SMART"

#. Onesa; French short form.
msgid "Onesa"
msgstr "Onesa"

#. VHL role (IHE ITI VHL Receiver).
msgid "Receiver"
msgstr "destinataire"

#. Public Key Infrastructure: owner ruling 2026-11-07, French ICP; first use on a
#. page reads « infrastructure à clés publiques (ICP, en anglais PKI) ».
msgid "PKI"
msgstr "ICP"

