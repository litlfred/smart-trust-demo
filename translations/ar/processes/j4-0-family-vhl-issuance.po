msgstr "تخطط الأسرة للسفر إلى الخارج"

#: processes/content/j4-0-family-vhl-issuance.bpmn:43
#. Diagram label
msgid "Finish the HC1 QR text"
msgstr "إنهاء نص QR بصيغة HC1"

#: processes/content/j4-0-family-vhl-issuance.bpmn:30
#. Diagram label
