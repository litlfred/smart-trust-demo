{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/trust-demo/ValueSet-TrustDemoVerificationStepVS.displays.json",
  "title": "Verification steps Display Values",
  "description": "Display values for Verification steps ValueSet codes. Generated from FHIR expansions. Keys are code fragments (the part after '#' in the canonical IRI). The full IRI can be reconstructed as system + '#' + code.",
  "type": "object",
  "properties": {
    "fhir:displays": {
      "type": "object",
      "description": "Multilingual display values for ValueSet codes keyed by code fragment",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "description": "Display values for a specific code fragment by language",
          "properties": {
            "en": {
              "type": "string",
              "description": "English display value"
            }
          },
          "patternProperties": {
            "^[a-z]{2}(-[A-Z]{2})?$": {
              "type": "string",
              "description": "Display value in the specified language (ISO 639-1 code)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "fhir:displays"
  ],
  "additionalProperties": true,
  "fhir:displays": {
    "prefix": {
      "en": "Prefix"
    },
    "base45": {
      "en": "Base45"
    },
    "inflate": {
      "en": "Inflate"
    },
    "cose": {
      "en": "COSE"
    },
    "header": {
      "en": "Header"
    },
    "trust-lookup": {
      "en": "Trust lookup"
    },
    "signature": {
      "en": "Signature"
    },
    "key-usage": {
      "en": "Key usage"
    },
    "cwt": {
      "en": "CWT"
    },
    "time": {
      "en": "Time"
    },
    "hcert": {
      "en": "HCERT"
    },
    "payload": {
      "en": "Payload"
    }
  },
  "fhir:valueSet": "http://smart.who.int/trust-demo/ValueSet/TrustDemoVerificationStepVS",
  "fhir:version": "0.1.0",
