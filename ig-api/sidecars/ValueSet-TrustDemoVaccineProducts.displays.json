{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/trust-demo/ValueSet-TrustDemoVaccineProducts.displays.json",
  "title": "Vaccine products of the journeys Display Values",
  "description": "Display values for Vaccine products of the journeys ValueSet codes. Generated from FHIR expansions. Keys are code fragments (the part after '#' in the canonical IRI). The full IRI can be reconstructed as system + '#' + code.",
  "type": "object",
  "properties": {
    "fhir:displays": {
      "type": "object",
      "description": "Multilingual display values for ValueSet codes keyed by code fragment",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "description": "Display values for a specific code fragment by language",
          "properties": {
            "en": {
              "type": "string",
              "description": "English display value"
            }
          },
          "patternProperties": {
            "^[a-z]{2}(-[A-Z]{2})?$": {
              "type": "string",
              "description": "Display value in the specified language (ISO 639-1 code)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "fhir:displays"
  ],
  "additionalProperties": true,
  "fhir:displays": {
    "vp-hepb-peds-monovalent": {
      "en": "Hepatitis B vaccine, paediatric, monovalent"
    },
    "vp-bcg-freeze-dried": {
      "en": "BCG vaccine, freeze-dried"
    },
    "vp-pentavalent-liquid": {
      "en": "DTP-HepB-Hib (pentavalent), liquid"
    },
    "vp-bopv-drops": {
      "en": "Bivalent oral polio vaccine (bOPV), drops"
    },
    "vp-pcv-13-dose": {
      "en": "Pneumococcal conjugate vaccine (PCV)"
    },
    "vp-mr-freeze-dried": {
      "en": "Measles-rubella vaccine, freeze-dried"
    }
  },
  "fhir:valueSet": "http://smart.who.int/trust-demo/ValueSet/TrustDemoVaccineProducts",
  "fhir:version": "0.1.0",
  "fhir:expansionTimestamp": "2026-11-12T11:47:34+00:00"
}