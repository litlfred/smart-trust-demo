    {
      "@id": "PlanDefinition-TrustDemoDT01",
      "@type": "fhir:PlanDefinition",
      "dcterms:identifier": "PlanDefinition/TrustDemoDT01",
      "dcterms:title": "TD.DT.01 What does a scanned DVC become in the child's record?",
      "dcterms:description": "From the result of reading one foreign DVC, decide whether its dose is recorded as verified, kept as reported and not verified, or not recorded from it at all. Requirements: STT-VER-001, STT-VER-006, STT-VER-008, STT-VER-011. Hit policy FIRST: the rules are tried in order and the first that matches applies.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-demo/PlanDefinition/TrustDemoDT01"
      },
      "schema:contentUrl": {
        "@id": "../PlanDefinition-TrustDemoDT01.json"
      }
    },
    {
      "@id": "PlanDefinition-TrustDemoDT02",
      "@type": "fhir:PlanDefinition",
      "dcterms:identifier": "PlanDefinition/TrustDemoDT02",
      "dcterms:title": "TD.DT.02 Which national schedule code does an imported dose carry?",
      "dcterms:description": "For one dose, decide whether and how the national schedule code is added beside the issuer's product code, which is always kept. Requirements: STD-SEM-001. Hit policy FIRST: the rules are tried in order and the first that matches applies.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-demo/PlanDefinition/TrustDemoDT02"
      },
      "schema:contentUrl": {
        "@id": "../PlanDefinition-TrustDemoDT02.json"
      }
    },
    {
      "@id": "PlanDefinition-TrustDemoDT03",
      "@type": "fhir:PlanDefinition",
      "dcterms:identifier": "PlanDefinition/TrustDemoDT03",
      "dcterms:title": "TD.DT.03 Does the national schedule count this dose?",
      "dcterms:description": "For one Immunization in the child's record, decide whether the schedule evaluation counts it as given. Requirements: STD-SCH-001, STD-SEM-001. Hit policy FIRST: the rules are tried in order and the first that matches applies.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-demo/PlanDefinition/TrustDemoDT03"
      },
      "schema:contentUrl": {
        "@id": "../PlanDefinition-TrustDemoDT03.json"
      }
    },
    {
      "@id": "PlanDefinition-TrustDemoDT04",
      "@type": "fhir:PlanDefinition",
      "dcterms:identifier": "PlanDefinition/TrustDemoDT04",
      "dcterms:title": "TD.DT.04 Is this dose of the national schedule due?",
      "dcterms:description": "For one action of the national schedule, decide whether the evaluation recommends it now, and from which date. Requirements: STD-SCH-001. Hit policy FIRST: the rules are tried in order and the first that matches applies.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-demo/PlanDefinition/TrustDemoDT04"
      },
      "schema:contentUrl": {
        "@id": "../PlanDefinition-TrustDemoDT04.json"
      }
    },
    {
      "@id": "PlanDefinition-TrustDemoDT05",
      "@type": "fhir:PlanDefinition",
      "dcterms:identifier": "PlanDefinition/TrustDemoDT05",
      "dcterms:title": "TD.DT.05 Does the portal release the manifest for this request?",
      "dcterms:description": "For one manifest request (ITI-YY5), decide whether the portal releases the manifest, and what the access log records. Requirements: STD-ACC-001. Hit policy FIRST: the rules are tried in order and the first that matches applies.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-demo/PlanDefinition/TrustDemoDT05"
      },
      "schema:contentUrl": {
        "@id": "../PlanDefinition-TrustDemoDT05.json"
      }
    },
    {
      "@id": "PlanDefinition-TrustDemoDT06",
      "@type": "fhir:PlanDefinition",
      "dcterms:identifier": "PlanDefinition/TrustDemoDT06",
      "dcterms:title": "TD.DT.06 Does the receiver follow the VHL?",
      "dcterms:description": "For one scanned VHL, decide whether the receiver requests the manifest or treats the family's records like paper. Requirements: STT-VER-001, STT-VER-008, STT-VHL-009, STT-VHL-005. Hit policy FIRST: the rules are tried in order and the first that matches applies.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-demo/PlanDefinition/TrustDemoDT06"
      },
      "schema:contentUrl": {
        "@id": "../PlanDefinition-TrustDemoDT06.json"
      }
    },
    {
