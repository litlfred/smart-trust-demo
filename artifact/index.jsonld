    {
      "@id": "ValueSet-TrustDemoTrustDomains",
      "@type": "fhir:ValueSet",
      "dcterms:identifier": "ValueSet/TrustDemoTrustDomains",
      "dcterms:title": "Trust domains of the journeys",
      "dcterms:description": "Every code of TrustDemoTrustDomain: the trust domains a verifier in the journeys accepts.",
      "dcterms:type": "Terminology: Value Sets",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-demo/ValueSet/TrustDemoTrustDomains"
      },
      "schema:contentUrl": {
        "@id": "../ValueSet-TrustDemoTrustDomains.json"
      }
    },
    {
      "@id": "ValueSet-TrustDemoVaccineProducts",
      "@type": "fhir:ValueSet",
      "dcterms:identifier": "ValueSet/TrustDemoVaccineProducts",
      "dcterms:title": "Vaccine products of the journeys",
      "dcterms:description": "Every product code of TrustDemoVaccineProduct: the source of the national ConceptMap.",
