    {
      "@id": "ConceptMap-TrustDemoProductToOnesaEpi",
      "@type": "fhir:ConceptMap",
      "dcterms:identifier": "ConceptMap/TrustDemoProductToOnesaEpi",
      "dcterms:title": "J3 map: vaccine product to national schedule dose",
      "dcterms:description": "The national map the clinic EHR uses in J3 to add the schedule code beside the issuer's product code, which it never replaces. The Hep B product had no entry until Nurse Chanthason confirmed its equivalence on 2025-11-25 (see TrustDemoJ3Adjudication); her decision is recorded here so the next clinic need not make it again.",
      "dcterms:type": "Terminology: Concept Maps",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-demo/ConceptMap/TrustDemoProductToOnesaEpi"
      },
      "schema:contentUrl": {
        "@id": "../ConceptMap-TrustDemoProductToOnesaEpi.json"
      }
    },
