      "dcterms:identifier": "ValueSet/TrustDemoOnesaEpiScheduleCodes",
      "dcterms:title": "National schedule codes of the journeys",
      "dcterms:description": "Every code of TrustDemoOnesaEpiSchedule: the target of the national ConceptMap.",
      "dcterms:type": "Terminology: Value Sets",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-demo/ValueSet/TrustDemoOnesaEpiScheduleCodes"
      },
