  "definition" : {
    "resource" : [{
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.BirthClinicSystem"
      },
      "name" : "Birth clinic issuing system",
      "description" : "The hospital system abroad that issues a DVC per dose with the HCERT library: the HCERT issuing system (smart-trust-tools) of a trust network participant (XXR).\n\n**Persona**: Software that calls the library once per dose and never holds the private key; signs only with a DSC its country's CSCA issued and has already shared with the GDHCN.\n\n**Also known as**: Issuer of the birth-dose DVCs (SMART Trust Issuer)\n\n**Played in the journeys by**: Provincial hospital system, Country A (XXR) (fictional).",
      "isExample" : false
    },
    {
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.BirthClinicVaccinator"
      },
      "name" : "Birth clinic vaccinator",
      "description" : "The clinician abroad who gives the birth doses and hands over the signed paper DVC (J1).\n\n**Persona**: A maternity-ward clinician who records doses in the hospital system and prints what it produces.\n\n**Played in the journeys by**: Dr Pimchanok WATTANA (birth clinic, abroad) (fictional).",
      "isExample" : false
    },
    {
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.Caregiver"
      },
      "name" : "Caregiver",
      "description" : "The parent who holds the child's paper DVCs and the family phone, and presents them; IHE ITI VHL VHL Holder and smart-trust Holder.\n\n**Persona**: A parent carrying a newborn's records across borders on paper and one shared phone; no health training, little time, limited connectivity.\n\n**Also known as**: VHL Holder (IHE ITI VHL); Holder (SMART Trust)\n\n**Played in the journeys by**: Mali SOUVANNALATH (mother) (fictional).",
      "isExample" : false
    },
    {
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.ChwApp"
      },
      "name" : "CHW app",
      "description" : "The OHS app on the CHW's phone: reads a foreign DVC without verifying it (triage read, STT-VER-011), registers the child and records a referral, all offline, syncing later.\n\n**Persona**: Offline-first Android app; must never present an unverified record as verified.\n\n**Also known as**: Triage reader (SMART Trust Receiver, read-unverified)\n\n**Played in the journeys by**: CHW app, Country B (fictional).",
      "isExample" : false
    },
    {
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.CommunityHealthWorker"
      },
      "name" : "Community health worker",
      "description" : "Finds unregistered children on home visits, registers them and refers them to the clinic (J2).\n\n**Persona**: Works on foot and offline, on a cheap Android phone; registers and refers, never judges authenticity.\n\n**Played in the journeys by**: Sita RAI (community health worker, home) (fictional).",
      "isExample" : false
    },
    {
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.FamilyPhone"
      },
      "name" : "Family phone",
      "description" : "The one smartphone the family shares, holding one VHL QR per member (J4); holds links, not keys to anyone's records beyond what each link grants.\n\n**Persona**: A shared Android phone, sometimes offline; whoever holds it can show any member's QR, the passcode protects the records.\n\n**Also known as**: Personal health wallet\n\n**Played in the journeys by**: The family's shared phone (fictional).",
      "isExample" : false
    },
    {
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.GdhcnTrustAnchor"
      },
      "name" : "GDHCN trust anchor",
      "description" : "WHO's GDHCN, which receives participants' PKI material and distributes it as DID trust lists; Trust Network Anchor (SMART Trust), Trust Anchor (IHE ITI VHL).\n\n**Persona**: A WHO service publishing DID documents over did:web; verifiers fetch it when online and keep a copy.\n\n**Also known as**: Trust Network Anchor (SMART Trust); Trust Anchor (IHE ITI VHL)\n\n**Played in the journeys by**: GDHCN DEV trust network (WHO) (fictional).",
      "isExample" : false
    },
    {
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.HomeClinicEhr"
      },
      "name" : "Home clinic EHR",
      "description" : "The clinic's OHS-based record system: verifies DVCs against the GDHCN trust list, imports them as FHIR Immunization resources and evaluates the national schedule (J3).\n\n**Persona**: Holds the DID trust list from its last refresh, about weekly for a clinic without its own connection, when the CHW visits the base clinic or district health office; loading it is a precondition of a visit, and it verifies offline at the point of care.\n\n**Also known as**: Verifier at the home clinic (SMART Trust Receiver)\n\n**Played in the journeys by**: Home clinic EHR, Country B (fictional).",
      "isExample" : false
    },
    {
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.HomeClinicProvider"
      },
      "name" : "Home clinic provider",
      "description" : "The nurse at the home clinic who receives the referral, has the foreign DVCs verified and decides catch-up doses (J3).\n\n**Persona**: Trusts the system's verdict and needs a reason when a certificate fails.\n\n**Played in the journeys by**: Tomas ALVES (nurse, home clinic) (fictional).",
      "isExample" : false
    },
    {
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.IssuerKey"
      },
      "name" : "Issuer signing key",
      "description" : "The DSC private key of the issuing participant, in an HSM, cloud KMS or Android Keystore; signs the bytes the issuing system prepares (two-phase signing, STT-ISS-004).\n\n**Persona**: A key that signs what it is given and reveals nothing else.\n\n**Also known as**: Document signer (DSC) key\n\n**Played in the journeys by**: XXR document signer key (Country A) (fictional).",
      "isExample" : false
    },
    {
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.NationalPortal"
      },
      "name" : "National health portal",
      "description" : "The home country's portal that issues each family member's records (IPS, DVCs) as a passcode-protected Verifiable Health Link and hosts the manifests (J4.0): the VHL Sharer.\n\n**Persona**: A government service signing with the national DSC, issued under the national CSCA and already shared with the GDHCN; hosts manifests and encrypted documents for a limited time.\n\n**Also known as**: VHL Sharer (IHE ITI VHL); Issuer of the family's VHLs (SMART Trust Issuer)\n\n**Played in the journeys by**: National health portal, Country B (XXH) (fictional).",
      "isExample" : false
    },
    {
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.PocProvider"
      },
      "name" : "Point-of-care provider",
      "description" : "The clinician abroad who scans the family's QR and reads the child's records (J4.1).\n\n**Persona**: Has minutes, no prior relationship with the family, and her own hospital's system.\n\n**Played in the journeys by**: Dr Ana MOREIRA (clinician abroad, J4.1) (fictional).",
      "isExample" : false
    },
    {
      "extension" : [{
        "url" : "http://hl7.org/fhir/tools/StructureDefinition/resource-information",
        "valueString" : "ActorDefinition"
      }],
      "reference" : {
        "reference" : "ActorDefinition/TrustDemo.Role.PocReceiver"
      },
      "name" : "Point-of-care receiver",
      "description" : "The clinic system abroad that scans a VHL, verifies it, fetches the manifest (ITI-YY5) and decrypts the documents (J4.1): the VHL Receiver.\n\n**Persona**: A hospital system on a trust network with its own receiver key; its DID trust list is a cache refreshed nightly or hourly, loaded before a visit, so it verifies without being online.\n\n**Also known as**: VHL Receiver (IHE ITI VHL); Receiver of the family's VHLs (SMART Trust Receiver)\n\n**Played in the journeys by**: Hospital system abroad (J4.1) (fictional).",
      "isExample" : false
    }],
